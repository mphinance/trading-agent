# ==============================================================================
# VESPER QUANT ENGINE - ENVIRONMENT CONTRACT (.env.vesper)
# ==============================================================================
# Sourced by: vesper-loop.service and vesper-listen.service
# Architecture: Autonomous scanner, risk gate, bot approval, execution & monitor
#
# NOTE ON CORE VARIABLES:
# Core credentials (WEBULL_*, TD_API_KEY, TDPRO_API_KEY, SEC_USER_AGENT) are
# intentionally duplicated across both .env.trading-agent and .env.vesper.
# Following the M0 modular split, both processes independently read the leaf
# core/ package (core.wb, core.md, core.td, core.edgar) for market data, dealer
# gamma, account balance, and SEC filings.
#
# SAFETY BOUNDARY (Rule 3 & Invariant I4):
# This process NEVER needs TRADING_AGENT_TOKEN, MCP_*, or any OAuth variables.
# VESPER_TRADING is the global kill-switch and strictly defaults to 0 (disabled).
# ==============================================================================

# --- Brokerage & Market Feeds (Core Layer) ---
WEBULL_APP_KEY=your_webull_app_key
WEBULL_APP_SECRET=your_webull_app_secret
WEBULL_REGION_ID=us
WEBULL_ENVIRONMENT=prod

# TraderDaddy / TDPro API Key (Momentum + Dealer Gamma GEX)
TD_API_KEY=your_td_api_key
TDPRO_API_KEY=your_tdpro_api_key

# SEC EDGAR User-Agent (User-Agent header is the required authentication)
SEC_USER_AGENT=Your Project Name (contact: you@example.com)

# --- Kill-Switch & Execution Guardrails ---
# 0 = disabled (dry-run / paper mode), 1 = live order placement enabled
VESPER_TRADING=0
VESPER_MAX_NOTIONAL=2500.0
VESPER_MAX_QUANTITY=25.0
VESPER_MAX_BP_FRACTION=1.0
# VESPER_SYMBOL_ALLOWLIST=SPY,QQQ,IWM

# --- Approval Channels & Notifications ---
# Telegram Bot (approval buttons + alert broadcasts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_AUTHORIZED_USER_IDS=12345678,87654321

# Discord Bot (dedicated approval channel #vesper-approvals)
# DISCORD_BOT_TOKEN=your_discord_bot_token
# DISCORD_CHANNEL_ID=your_discord_channel_id

# Webhook Inbound Listener (vesper-listen.service)
# WEBHOOK_SHARED_SECRET=your_webhook_shared_secret

# --- OpenRouter AI Model Gateway (Narrative / Red-Team / VoPR Only) ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
