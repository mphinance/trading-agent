[Unit]
Description=vesper-listen — Long-polling Approval & Command Listener
Documentation=file://%h/trading-agent/CLAUDE.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/trading-agent
EnvironmentFile=%h/trading-agent/.env.vesper
ExecStart=%h/trading-agent/.venv/bin/python vesper.py listen
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/trading-agent/data %h/trading-agent/conf
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
