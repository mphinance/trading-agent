[Unit]
Description=sidecar — Webull companion deck
Documentation=file:///home/mph/webull/sidecar/README.md
# Bound to a Tailscale address, so don't start before tailscaled has one.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/webull/sidecar
ExecStart=%h/webull/sidecar/run.sh
Restart=on-failure
RestartSec=5

# SIDECAR_HOST is written by deploy/install.sh to this machine's Tailscale IP.
# Never set it to 0.0.0.0: sidecar has no auth and holds live brokerage credentials.
EnvironmentFile=%h/webull/sidecar/deploy/sidecar.env

# If tailscaled isn't up yet at boot the bind fails; retry rather than give up.
StartLimitIntervalSec=300
StartLimitBurst=10

# Hardening. The app only needs to read its own tree and talk to the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/webull/sidecar %h/.claude
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=append:%h/webull/sidecar/sidecar.log
StandardError=append:%h/webull/sidecar/sidecar.log

[Install]
WantedBy=default.target
