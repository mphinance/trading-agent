__pycache__/
*.pyc
*.log
*.log.*
webull_trade_sdk.log*
webull_data_sdk.log*
.env
.env.*
!.env.example
.venv/
deploy/sidecar.env
.pytest_cache/
*.egg-info/
build/
dist/

# The Webull SDK writes its 2FA token to conf/token.txt under the working
# directory unless WEBULL_OPENAPI_TOKEN_DIR says otherwise. That is a live
# credential — never let it near a commit.
conf/
token.txt

# Generated/regenerable artifacts, not source — rebuilds from data/*.db and
# knowledge sources; committing the binary DB/PNGs just bloats history.
data/chromadb/
charts/

# Runtime state written by a live/paper run. Regenerable, changes every run,
# and audit_chain.jsonl in particular records real trade activity (tickers,
# quantities, prices) -- rule 5 says that does not get committed. The hash
# chain is its own tamper evidence; it does not need git for that.
data/audit_chain.jsonl
# Was tracked until 2026-08-30; untracked because every run rewrites it,
# and it records real conviction/trade history (rule 5).
data/conviction_journal.json
data/paper_ledger.json
data/halt_state.json
data/circuit_breaker_state.json
data/approval_registry_state.json
data/checkpoints.sqlite*
autonomous/harness/
.claude_settings.json
Cash Secured Puts-*.csv
Screenshot *.png
# harness copy of autonomous/prompts/app_spec.txt — keep one source of truth
/app_spec.txt
autonomous/logs/
