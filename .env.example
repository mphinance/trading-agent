# ==============================================================================
# VESPER QUANTITATIVE EXECUTION ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# TraderDaddy Pro MCP
TRADERDADDY_API_KEY=your_traderdaddy_api_key

# SEC EDGAR (edgar.py) -- no API key, this header IS the credential and must
# identify you with a real contact address, or sec.gov returns HTTP 403.
SEC_USER_AGENT=Your Project Name (contact: you@example.com)

# TickerTrace Pro MCP
TICKERTRACE_API_KEY=your_tickertrace_api_key

# Webull OpenAPI Execution
WEBULL_APP_KEY=your_webull_app_key
WEBULL_APP_SECRET=your_webull_app_secret
WEBULL_REGION_ID=us
WEBULL_ENVIRONMENT=prod

# Public.com Agentic Brokerage (Optional / Roadmap)
# https://public.com/ai-agents
PUBLIC_API_SECRET_KEY=your_public_api_secret_key
PUBLIC_ACCOUNT_ID=your_public_account_id

# Execution Broker Selection (webull | public)
EXECUTION_BROKER=webull

# OpenRouter AI Model Gateway (https://openrouter.ai)
# Default model: deepseek/deepseek-v4-flash ($0.03/1M in, $0.10/1M out)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

