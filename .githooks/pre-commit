#!/usr/bin/env bash
# Blocks a credential from being committed at all, rather than catching it in CI
# after it is already pushed to a PUBLIC repo.
#
# Enable (once per clone):
#     git config core.hooksPath .githooks
#
# deploy/install.sh does this for you, and tests/test_secret_hygiene.py pins
# that this hook exists and calls the shared scanner.
#
# Bypass is `git commit --no-verify`. If you find yourself reaching for it,
# the answer is almost always "that really is a credential".

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
scanner="$repo_root/scripts/scan_secrets.sh"

if [ ! -x "$scanner" ]; then
    echo "pre-commit: $scanner missing or not executable — refusing to skip the" >&2
    echo "credential scan silently. Restore it, or commit with --no-verify and" >&2
    echo "know that nothing checked." >&2
    exit 1
fi

"$scanner" --staged
