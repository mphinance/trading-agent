# ==============================================================================
# TRADING-AGENT MCP SERVER - ENVIRONMENT CONTRACT (.env.trading-agent)
# ==============================================================================
# Sourced by: trading-agent.service (owner-only MCP server on Coolify)
# Architecture: Single-operator MCP surface fronted by Traefik + OAuth 2.1
#
# NOTE ON CORE VARIABLES:
# Core credentials (WEBULL_*, TD_API_KEY, TDPRO_API_KEY, SEC_USER_AGENT) are
# intentionally duplicated across both .env.trading-agent and .env.vesper.
# Following the M0 modular split, both processes independently read the leaf
# core/ package (core.wb, core.md, core.td, core.edgar) for market data, dealer
# gamma, account balance, and SEC filings.
#
# SAFETY BOUNDARY (Rule 3 & Amendment A4):
# This process NEVER loads or needs TELEGRAM_* or VESPER_TRADING.
# It serves MCP clients over loopback/docker-bridge HTTP.
# ==============================================================================

# --- Brokerage & Market Feeds (Core Layer) ---
WEBULL_APP_KEY=your_webull_app_key
WEBULL_APP_SECRET=your_webull_app_secret
WEBULL_REGION_ID=us
WEBULL_ENVIRONMENT=prod

# TraderDaddy / TDPro API Key (Momentum + Dealer Gamma GEX)
TD_API_KEY=your_td_api_key
TDPRO_API_KEY=your_tdpro_api_key

# SEC EDGAR User-Agent (User-Agent header is the required authentication)
SEC_USER_AGENT=Your Project Name (contact: you@example.com)

# --- MCP Transport & Networking ---
# Bound to Docker bridge (10.0.0.1:8500) behind Traefik. Never 0.0.0.0.
MCP_TRANSPORT=http
MCP_HOST=10.0.0.1
MCP_PORT=8500
MCP_PUBLIC_URL=https://agent.mphinance.com

# --- Auth & OAuth 2.1 Configuration ---
# Operator secret used for static bearer authentication and OAuth signing
TRADING_AGENT_TOKEN=your_strong_random_secret_token

# Optional: client ID / redirect URI overrides for pre-registered OAuth clients
# TRADING_AGENT_CLIENT_ID=your_client_id
# TRADING_AGENT_REDIRECT_URI=https://claude.ai/api/mcp/oauth/callback

# --- MCP Order Guard Limits (Amendment A4) ---
MCP_MAX_NOTIONAL=1000.0
MCP_MAX_DAILY_ORDERS=5
